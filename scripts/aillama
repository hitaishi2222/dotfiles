#!/usr/bin/env bash

set -euo pipefail

# --- GPU Environment Configuration ---
export HSA_OVERRIDE_GFX_VERSION="11.5.1"
export GPU_MAX_HEAP_SIZE=100
export GPU_MAX_ALLOC_PERCENT=100
export GPU_MAX_SINGLE_ALLOC_PERCENT=100
export HSA_ENABLE_SDMA=0
export ROCBLAS_USE_HIPBLASLT=1
export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

# --- Constants ---
readonly APIKEY="HitiAIMaxx"
readonly MODEL_DIR="$HOME/Research/local_llms"
readonly FZF_CMD="fzf --height 40% --layout reverse --border"

# --- Model Registry ---
# Format: "Display Name|Path|Arguments"
# Note: Arguments are stored as a single string to be parsed into an array
models=(
    "Qwen3.5-9B-Q6|$MODEL_DIR/Qwen3.5-9B-UD-Q6_K_XL.gguf|-c 131072 --top-k 20 --min-p 0.00 --reasoning on --port 2000 --cache-type-k q8_0 --cache-type-v q8_0 --defrag-thold 0.1 --chat-template-kwargs '{"enable_thinking":true}' "
)

# --- Helper Functions ---

log_info() { printf "\e[34m[INFO]\e[0m %s\n" "$1"; }
log_err()  { printf "\e[31m[ERROR]\e[0m %s\n" "$1" >&2; }

check_dependencies() {
    local deps=("fzf" "llama-server" "llama-cli")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            log_err "Dependency '$dep' not found in PATH."
            exit 1
        fi
    done
}

handle_model() {
    local target_name="$1"
    local work_mode="$2"
    local entry=""

    # Find the exact matching entry using Bash pattern matching
    for m in "${models[@]}"; do
        if [[ "$m" == "$target_name|"* ]]; then
            entry="$m"
            break
        fi
    done

    if [[ -z "$entry" ]]; then
        log_err "Model configuration for '$target_name' not found."
        exit 1
    fi

    local name="${entry%%|*}"
    local remainder="${entry#*|}"
    local path="${remainder%%|*}"
    local args_str="${remainder#*|}"

    if [[ ! -f "$path" ]]; then
        log_err "Model file not found: $path"
        exit 1
    fi

    # Convert the arguments string into an array safely
    # We use 'eval' here ONLY because we are parsing a string designed
    # to contain shell-style arguments (like quotes).
    local extra_args=()
    eval "extra_args=($args_str)"

    local common_args=(-m "$path" -ngl 99 -t 20)

    log_info "Launching $name in $work_mode mode..."

    if [[ "$work_mode" == "server" ]]; then
        llama-server "${common_args[@]}" "${extra_args[@]}" \
            --host 0.0.0.0 --jinja
    else
        llama-cli "${common_args[@]}" "${extra_args[@]}"
    fi
}

# --- Main Execution ---

main() {
    check_dependencies

    # 1. Select Model
    local selected_model
    selected_model=$(printf '%s\n' "${models[@]}" | cut -d'|' -f1 | $FZF_CMD)
    [[ -z "$selected_model" ]] && { log_err "No model selected"; exit 1; }

    # 2. Select Mode
    local work_mode
    work_mode=$(printf '%s\n' "server" "ai" | $FZF_CMD)
    [[ -z "$work_mode" ]] && { log_err "No mode selected"; exit 1; }

    handle_model "$selected_model" "$work_mode"
}

main "$@"
