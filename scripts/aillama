#!/usr/bin/env bash

set -aeu
export HSA_OVERRIDE_GFX_VERSION=11.5.1
export GPU_MAX_HEAP_SIZE=100
export GPU_MAX_ALLOC_PERCENT=100
export GPU_MAX_SINGLE_ALLOC_PERCENT=100
export HSA_ENABLE_SDMA=0
export ROCBLAS_USE_HIPBLASLT=1
export GGML_CUDA_ENABLE_UNIFIED_MEMORY=1

export APIKEY="HitiAIMaxx"

my_fzf="fzf --height 40% --layout reverse --border"

models=("Qwen2.5-Coder-14B-Instruct-Q5" "DeepSeek-R1-Distill-7B" "Qwen3.5-9B-GGUF_Qwen3.5-9B-UD-Q4")
option=$(printf '%s\n' "${models[@]}" | $my_fzf)
[[ -z "$option" ]] && { echo "No model selected"; exit 1; }
echo "Selected: $option"

work=$(printf '%s\n' "server" "ai" | $my_fzf)
[[ -z "$work" ]] && { echo "No mode selected"; exit 1; }
echo "Mode: $work"

handle_model() {
    local model="$1"
    shift
    local extra_args=()

    case "$model" in
        "Qwen2.5-Coder-14B-Instruct-Q5")
            export GGML_JINJA_FILE=~/Research/local_llms/qwen2.5-coder-14b.jinja
            extra_args=(-m ~/Research/local_llms/qwen2.5-coder-14b-instruct-q5_k_m.gguf -t 16 -tb 24 -c 65538 -b 4096 -ub 2024 --cache-type-k q4_0 --cache-type-v q4_0 -np 1 -mg 0 --no-warmup)
            ;;
        "DeepSeek-R1-Distill-7B")
            extra_args=(-m ~/Research/local_llms/deepseek_r1_distill_7b_q8.gguf)
            ;;
        "Qwen3.5-9B-GGUF_Qwen3.5-9B-UD-Q4")
            extra_args=(-m ~/Research/local_llms/unsloth_Qwen3.5-9B-GGUF_Qwen3.5-9B-UD-Q4_K_XL.gguf -c 65536 --top-k 20 --min-p 0.00 --reasoning on)
            ;;
    esac

    if [[ "$work" == "server" ]]; then
        llama-server "${extra_args[@]}" --host 127.0.0.1 --port 2000 -ngl 99 -fa 1 -t 8 --jinja --api-key "$APIKEY"
    elif [[ "$work" == "ai" ]]; then
        llama-cli "${extra_args[@]}" -ngl 99 -fa 1 -t 8
    else
        echo "Nothing selected"
        return 1
    fi
}

handle_model "$option" "$@"
