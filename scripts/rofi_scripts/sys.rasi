configuration {
    matching: "fuzzy";
    show-icons: false;
    font: "JetBrainsMono NF 13";
}

* {
    background-color: #3B3E40;
    text-color: #AAA7A4;
    border: 1px;
    border-radius: 20px;
}


#window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 400px;
    height: 200px;
    x-offset: 0px;
    y-offset: 0px;
    background-color: transparent;
}

listview {
    background-color:  transparent;
    padding: 20px;
}

inputbar {
    enabled: false;
    padding: 10px;
    spacing: 0;
}

element {
    enabled: true;
    text-color: #AAA7A4;
    cursor: pointer;
    padding: 5px;
}

element-text {
    enabled: true;
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

element selected {
    background-color: #957B7E;
    text-color: #3B3E40;
}


