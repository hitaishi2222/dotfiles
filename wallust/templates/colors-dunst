[global]
monitor = 0
follow = none
width = 400
height = 400
origin = top-right
offset = 10x60
scale = 0
notification_limit = 5
progress_bar = true
progress_bar_height = 10
progress_bar_frame_width = 1
progress_bar_min_width = 150
progress_bar_max_width = 300
indicate_hidden = yes
transparency = 0
gap_size = 10
separator_height = 10
separator_color = auto
padding = 10
horizontal_padding = 10
text_icon_padding = 0
frame_width = 1
sort = yes
font = JetBrains Mono 12
line_height = 8
markup = full
format = "<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
show_age_threshold = 60
ellipsize = middle
ignore_newline = no
stack_duplicates = true
hide_duplicate_count = false
show_indicators = yes
icon_position = left
min_icon_size = 0
max_icon_size = 32
sticky_history = yes
history_length = 20
browser = /usr/bin/xdg-open
always_run_script = true
title = Dunst
class = Dunst
corner_radius = 20
ignore_dbusclose = false
force_xwayland = true
force_xinerama = false
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all
frame_color = "{{color10}}"
highlight = "{{foreground}}"
separator_color= "{{color7}}"

[experimental]
per_monitor_dpi = false

[urgency_normal]
timeout = 2
background = "{{color2}}"
foreground = "{{background}}"
highlight = "{{foreground}}"

[urgency_low]
timeout = 3
background = "{{color12}}"
foreground = "{{background}}"
highlight = "{{foreground}}"

[urgency_critical]
timeout = 0
background = "{{color11}}"
foreground = "{{background}}"
highlight = "{{foreground}}"

