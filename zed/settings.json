// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "assistant": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-5-sonnet-latest"
    },
    "version": "2"
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMonoNL Nerd Font Propo",
  "format_on_save": "prettier",
  "relative_line_numbers": true,
  "use_autoclose": true,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "terminal": {
    "font_family": "JetBrains Mono"
  },
  "languages": {
    "Python": {
      "tab_size": 4,
      "formatter": "language_server",
      "format_on_save": "on"
    },
    "JavaScript": {
      "tab_size": 2,
      "language_servers": ["typescript-language-server", "!vtsls", "..."],
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"]
        }
      }
    }
  },
  "lsp": {
    "scls": {
      "initialization_options": {
        "max_completion_items": 6, // set max completion results len for each group: words, snippets, unicode-input
        "feature_words": false, // enable completion by word
        "feature_unicode_input": false, // enable "unicode input"
        "snippets_first": true, // completions will return before snippets by default
        "feature_snippets": true, // enable snippets
        "feature_paths": true // enable path completion
      }
    },
    "ruff": {
      "settings": {
        "python.analysis": {
          "diagnosticMode": "workspace",
          "typeCheckingMode": "strict"
        },
        "python": {
          "pythonPath": "/home/hiti/.pyenv/versions/3.13.0/envs/.zed_env"
        }
      }
    }
  }
}
